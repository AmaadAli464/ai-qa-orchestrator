{
  "name": "add-to-cart",
  "description": "Add an item to the cart on the public demo shop. Changes cart state, so it is not read-only.",
  "readOnly": false,
  "steps": [
    { "action": "goto", "url": "https://www.saucedemo.com/", "note": "open the demo shop" },
    { "action": "fill", "locators": ["[data-test='username']", "#user-name"], "value": "${ENV:DEMO_USER:standard_user}", "note": "enter username" },
    { "action": "fill", "locators": ["[data-test='password']", "#password"], "value": "${ENV:DEMO_PASSWORD:secret_sauce}", "note": "enter password" },
    { "action": "click", "locators": ["[data-test='login-button']", "#login-button"], "note": "submit the login form" },
    { "action": "click", "locators": ["[data-test='add-to-cart-sauce-labs-backpack']"], "mutates": true, "note": "add the backpack to the cart" },
    { "action": "expect_text", "locators": [".shopping_cart_badge", "[data-test='shopping-cart-badge']"], "value": "1", "note": "cart badge shows 1" },
    { "action": "click", "locators": [".shopping_cart_link", "[data-test='shopping-cart-link']"], "note": "open the cart" },
    { "action": "expect_text", "locators": [".inventory_item_name", "[data-test='inventory-item-name']"], "value": "Sauce Labs Backpack", "note": "cart lists the backpack" }
  ]
}
